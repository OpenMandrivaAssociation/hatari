diff -ruN a/src/main.c b/src/main.c
--- hatari-2.6.1/src/main.c	2025-08-15 16:09:48.000000000 +0200
+++ hatari-2.6.1/src/main.c	2026-09-21 03:17:20.982449762 +0200
@@ -786,7 +786,17 @@
 	   will be initialized later (failure not fatal). */
 	if (SDL_Init(SDL_INIT_VIDEO) < 0)
 	{
-		Main_ErrorExit("Could not initialize the SDL library:", SDL_GetError(), -1);
+		const char *videodriver = getenv("SDL_VIDEODRIVER");
+		if (videodriver && strcmp(videodriver, "wayland") == 0)
+		{
+			Log_Printf(LOG_INFO, "Wayland video init failed (%s), falling back to X11\n",
+			           SDL_GetError());
+			setenv("SDL_VIDEODRIVER", "x11", 1);
+			if (SDL_Init(SDL_INIT_VIDEO) < 0)
+				Main_ErrorExit("Could not initialize the SDL library:", SDL_GetError(), -1);
+		}
+		else
+			Main_ErrorExit("Could not initialize the SDL library:", SDL_GetError(), -1);
 	}
 
 	if ( IPF_Init() != true )
@@ -1059,6 +1069,13 @@
 	/* Needed on maemo but useful also with normal X11 window managers for
 	 * window grouping when you have multiple Hatari SDL windows open */
 	setenv("SDL_VIDEO_X11_WMCLASS", "hatari", 1);
+	/* Prefer native Wayland so KDE does not leave an unfocused XWayland
+	 * window behind the terminal. hatariui embedding still needs X11. */
+	if (!getenv("SDL_VIDEODRIVER") && getenv("WAYLAND_DISPLAY")
+	    && !getenv("PARENT_WIN_ID"))
+		setenv("SDL_VIDEODRIVER", "wayland", 0);
+	if (!getenv("SDL_VIDEO_X11_NET_WM_BYPASS_COMPOSITOR"))
+		setenv("SDL_VIDEO_X11_NET_WM_BYPASS_COMPOSITOR", "0", 0);
 #endif
 
